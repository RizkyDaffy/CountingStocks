# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
HOST=0.0.0.0
PORT=4002

# ── Reverse proxy ────────────────────────────────────────────────────────────
# Number of trusted proxy hops in front of this service (nginx = 1).
# Required for correct client IP in rate limiting. 0 = direct exposure.
TRUST_PROXY=1

# ── Security ─────────────────────────────────────────────────────────────────
# Comma-separated CORS origin allowlist. No wildcards in production.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Max request body size.
BODY_LIMIT=128kb
# Rate limiting: requests per window per client IP.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# ── OpenAPI docs ─────────────────────────────────────────────────────────────
# Docs at /api/docs. Auto-enabled outside production; set explicitly otherwise.
SWAGGER_ENABLED=true
# Public base URL used for OpenAPI server entry (e.g. https://sheet.example.com)
PUBLIC_BASE_URL=http://localhost:4002

# ── Google Sheets (MCP) ──────────────────────────────────────────────────────
# Target spreadsheet for /api/v1/sheets/analyze
GOOGLE_SPREADSHEET_ID=18A9v3_zzugc0obDRY1BfvZliMsp4ceI0M6cFJRWpv9A
# Path to the service account key JSON (rizkydaffy@sugity.iam.gserviceaccount.com).
# Share the spreadsheet with that email in Google Sheets, Editor access.
# Key stored outside repo public dirs — path relative to this service's folder.
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=../../brain/sugity-a4887dfc9882.json
# Background cache refresh interval in ms (min enforced: 5000). Edits on the
# spreadsheet become visible within this window on all /sheets endpoints.
SHEETS_POLL_INTERVAL_MS=10000
