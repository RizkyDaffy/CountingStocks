# Database Configuration (Configure your providers)
DB_HOST=localhost
DB_PORT=3306
DB_USER=userdb
DB_PASSWORD=password
DB_NAME=database_name

# Express api server (make sure the port right)
API_PORT=4000
VITE_API_PORT=4000

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000,http://locahost:5173

# JWR Secret key (encrpy with sha-1 or other one way encrption)
JWT_SECRET=secret_key

# Base url for the application (make sure the url right)
API_BASE_URL=http://[ip]:4000 #ganti ini 

# BETA: IRIS CONFIGURATION
INTERNAL_API_KEY=secret_internal_api_key
VITE_INTERNAL_API_KEY=secret_internal_api_key
IRIS_PROJECT_TOKEN=
IRIS_GATEWAY_URL=

# Business Continues Plan (/backup): main API -> google-sheet microservice
GOOGLE_SHEETS_SERVICE_URL=http://localhost:4002
BCP_SYNC_ENABLED=true
BCP_SYNC_INTERVAL_MS=15000